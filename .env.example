# ==============================================================================
# PLANTILLA DE VARIABLES DE ENTORNO — BACKEND (tienda_web_backend)
# Copia este archivo como ".env" para trabajar en LOCAL o configura las mismas
# claves en Render -> Web Service -> Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BASE DE DATOS POSTGRESQL (Obligatorio en Render y Local)
# ------------------------------------------------------------------------------
# En Render usa la Internal Database URL convertida a formato JDBC:
#   SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<nombre_bd>
#   SPRING_DATASOURCE_USERNAME=<usuario_bd>
#   SPRING_DATASOURCE_PASSWORD=<password_bd>
#
# Para seguir en LOCAL (descomenta en tu .env local):
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bd_sistema_negocio
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=TU_PASSWORD_POSTGRES_LOCAL

# ------------------------------------------------------------------------------
# 2. SEGURIDAD CORS (Frontend permitido -> Render o Local)
# ------------------------------------------------------------------------------
# En Render coloca la URL exacta de tu Static Site (sin barra final), ej.:
#   CORS_ALLOWED_ORIGINS=https://techstore-frontend.onrender.com
# Si usas varios orígenes (producción + local) sepáralos por coma:
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# ------------------------------------------------------------------------------
# 3. APIS EXTERNAS (RENIEC / SUNAT y CLOUDINARY)
# ------------------------------------------------------------------------------
# Token en: https://apisperu.com -> dniruc.apisperu.com
APIPERU_TOKEN=

# Credenciales de Cloudinary (obtener en Console -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional alternativo:
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ------------------------------------------------------------------------------
# 4. SEMILLA INICIAL DE USUARIOS (Solo primer arranque en BD vacía)
# En Render define contraseñas fuertes (o déjalo vacío si ya creaste los usuarios).
# ------------------------------------------------------------------------------
# SEED_ADMIN_PASSWORD=cambia_esta_clave_segura_admin
# SEED_ALMACEN_PASSWORD=cambia_esta_clave_segura_almacen

# ------------------------------------------------------------------------------
# 5. LOGS SQL (Opcional: false en Render para no saturar logs, true en local)
# ------------------------------------------------------------------------------
# JPA_SHOW_SQL=true
# JPA_FORMAT_SQL=true

# ------------------------------------------------------------------------------
# 6. CORREO TRANSACCIONAL BREVO (API v3 HTTPS — Verificación, 2FA y Clave)
# ------------------------------------------------------------------------------
# Obtén una clave restringida ("Emails transaccionales: Todos") en app.brevo.com
# y configura un remitente verificado (Sender).
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TechStore

# ------------------------------------------------------------------------------
# 7. LIMITES DIARIOS PREVENTIVOS (Opcional — valores por defecto recomendados)
# ------------------------------------------------------------------------------
# LIMITE_DIARIO_BREVO=250
# LIMITE_DIARIO_CONSULTAS_FISCALES=400
# LIMITE_DIARIO_CLOUDINARY=150
