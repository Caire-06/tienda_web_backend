# Copia este archivo como ".env" dentro de tienda_web_backend/ y coloca tus claves reales.
# Token en: https://apisperu.com (servicio DNI & RUC -> dniruc.apisperu.com)
APIPERU_TOKEN=

# Credenciales de Cloudinary (obtener en Console -> API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Opcional alternativo: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
